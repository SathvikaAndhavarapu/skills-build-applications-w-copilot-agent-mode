# Octofit Tracker - Frontend Environment Variables

# REQUIRED for Codespaces deployment
# Set this to your Codespace name to enable Codespaces API endpoint
# Example: upgraded-barnacle-qv9wx64ww654h9vwj
# When set, the API will use: https://${VITE_CODESPACE_NAME}-8000.app.github.dev
# When unset or in local development, the API defaults to: http://localhost:8000
VITE_CODESPACE_NAME=

# API Base URL (optional - automatically determined)
# Leave empty to auto-detect based on VITE_CODESPACE_NAME
# VITE_API_BASE_URL=http://localhost:8000
